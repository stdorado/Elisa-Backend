# ─── Base de datos ───────────────────────────────
# URL del proyecto en Supabase
# Settings → API → Project URL
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Clave pública — solo INSERT vía RLS
# Settings → API → anon public
SUPABASE_ANON_KEY=eyJ...

# Clave privada — SELECT y DELETE, nunca al frontend
# Settings → API → service_role secret
SUPABASE_SERVICE_KEY=eyJ...

# ─── Autenticación admin ─────────────────────────
# Token para acceder al panel de administración
# Usá algo que puedas recordar pero no obvio
ADMIN_TOKEN=tu_token_aqui

# ─── HMAC (verificación de QRs físicos) ──────────
# Clave para firmar/verificar el token de cada zona
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HMAC_SECRET=tu_secret_hmac_de_64_hex

# ─── CORS ────────────────────────────────────────
# URL del frontend en producción (Vercel)
# En desarrollo: http://localhost:5173
FRONTEND_URL=https://tu-app.vercel.app

# ─── Servidor ────────────────────────────────────
# Railway asigna el puerto automáticamente
# No cambiar este valor
PORT=8080

# ─── Entorno ─────────────────────────────────────
# 'development' o 'production'
# En Railway configurar como 'production'
NODE_ENV=development
